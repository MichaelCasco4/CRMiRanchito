<?xml version = "1.0" encoding = "ISO-8859-1"?>

<!DOCTYPE controllers SYSTEM "dtds/controllers.dtd">

<!-- 
Controllers doc: 
https://www.openxava.org/OpenXavaDoc/docs/controllers_en.html

Default controllers included in OpenXava (you can extend from them):
https://github.com/openxava/openxava/blob/master/openxava/src/main/resources/xava/default-controllers.xml
 
Examples of controllers (from test application):
https://github.com/openxava/openxava/blob/master/openxavatest/src/main/resources/xava/controllers.xml
-->

<controllers>
    
    <!-- Environment variable:
    <env-var name="CRM_DEFAULT_YEAR" value="2015"/> 
    -->
    
    <!-- Session object:
    <object name="CRM_activeYear" class="java.lang.Integer" value="2015" 
    	    scope="global"/>    
    -->
    <controller name="SignIn">
        <action name="init" on-init="true" hidden="true"
                class="com.openxava.naviox.actions.InitSignInAction"/>
        <action name="signIn"
                class="org.example.crmiranchito.actions.SignInAction"/>
    </controller>



    <controller name="Reserva">

        <action name="guardarReserva"
                class="org.example.crmiranchito.actions.MiSaveReservaAction"
                label="Guardar"
                icon="save"
                mode="detail"/>

        <action name="asignarMesa"
                class="org.example.crmiranchito.actions.AsignarMesa"
                label="Asignar Mesa"
                icon="calendar-check"
                mode="detail"/>

        <action name="buscarMesasDisponibles"
                class="org.example.crmiranchito.actions.BuscarMesasDisponibles"
                label="Buscar Mesas"
                icon="account-search"
                mode="detail"/>

        <action name="actualizarEstado"
                class="org.example.crmiranchito.actions.ActualizarEstadoAlAbrir"
                on-init="true"
                hidden="true"/>


    </controller>


    <controller name="Usuario">

        <action name="cambiarCredenciales"
                class="org.example.crmiranchito.actions.CambiarCredencialesAction"
                label="Cambiar Credenciales"
                icon="key"
                mode="detail"/>

        <action name="guardarCredenciales"
                class="org.example.crmiranchito.actions.GuardarCredencialesAction"
                hidden="true"/>
    </controller>

    <controller name="ReporteSatisfaccion">
        <action name="cargarGraficos"
                class="org.example.crmiranchito.actions.CargarGraficosReporteAction"
                label="Cargar graficos"
                mode="detail"
                icon="chart-bar"/>
    </controller>









    <!-- Controller:
    <controller name="Teacher">
    	<extends controller="Typical"/>
    	<action name="new" icon="plus-box-multiple" keystroke="Control N"
        	class="actions.CreateTeacher">
    	</action>
	</controller>    
    -->
    
</controllers>
